# Strapi Backend Connection
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
STRAPI_INTERNAL_URL=http://backend:1337

# Instagram Live Feed
# Option A: Meta Instagram Graph API Long-Lived Token (or User Token)
INSTAGRAM_ACCESS_TOKEN=
# Option B: Custom Proxy / Aggregator Endpoint (e.g. Behold.so or internal API)
# INSTAGRAM_FEED_URL=
# Cache Revalidation in seconds (defaults to 3600 = 1 hour)
INSTAGRAM_CACHE_REVALIDATE=3600
# YouTube Public Channel Feed (No API Key required)
# Channel ID starting with UC...
YOUTUBE_CHANNEL_ID=
# Or custom direct Atom/RSS feed URL:
# YOUTUBE_FEED_URL=https://www.youtube.com/feeds/videos.xml?channel_id=...
# Cache duration in seconds (defaults to 3600 = 1 hour)
YOUTUBE_CACHE_REVALIDATE=3600

# Social Feed Grid Frequency (defaults to 6)
NEXT_PUBLIC_SOCIAL_FEED_INTERVAL=6
