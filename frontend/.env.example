# Strapi Backend Connection
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
STRAPI_INTERNAL_URL=http://backend:1337

# Instagram Live Feed
# Option A: Meta Instagram Graph API Long-Lived Token (or User Token)
INSTAGRAM_ACCESS_TOKEN=
# Option B: Custom Proxy / Aggregator Endpoint (e.g. Behold.so or internal API)
# INSTAGRAM_FEED_URL=
# Cache Revalidation in seconds (defaults to 3600 = 1 hour)
INSTAGRAM_CACHE_REVALIDATE=3600
# Interval of blog posts between Instagram cards (defaults to 6)
NEXT_PUBLIC_INSTAGRAM_FEED_INTERVAL=6
NEXT_PUBLIC_INSTAGRAM_HANDLE=houseforcespain
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/houseforcespain
