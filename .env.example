# ==============================================================================
# HouseForce Monorepo Development Environment Variables
# ==============================================================================

# Database Configuration (PostgreSQL container in docker-compose.yml)
DATABASE_CLIENT=postgres
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=password
DATABASE_SSL=false

# Strapi Application Keys & Secrets
APP_KEYS=changeMe1,changeMe2
API_TOKEN_SALT=changeMe
ADMIN_JWT_SECRET=changeMe
TRANSFER_TOKEN_SALT=changeMe
JWT_SECRET=changeMe

# MinIO Local S3 Object Store
DO_SPACE_ACCESS_KEY=minioadmin
DO_SPACE_SECRET_KEY=minioadminpassword
DO_SPACE_ENDPOINT=http://minio:9000
DO_SPACE_BUCKET=uploads
DO_SPACE_REGION=us-east-1

# Development Test Seeding
SEED_TEST_DATA=true
SEED_ADMIN_EMAIL=staff@houseforce.com
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_CLIENT_EMAIL=client@example.com
SEED_CLIENT_PASSWORD=password123

# Customer Portal Auth & Integration
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=local-development-secret-key-12345
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Service Desk (Postmark - optional for local dev)
POSTMARK_API_TOKEN=
EMAIL_DOMAIN=replies.houseforce.com
EMAIL_DEFAULT_FROM=updates@replies.houseforce.com
PORTAL_URL=http://localhost:3001

# Social Feeds (Marketing Frontend)
INSTAGRAM_ACCESS_TOKEN=
NEXT_PUBLIC_INSTAGRAM_HANDLE=houseforcespain
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/houseforcespain

# YouTube Public Feed
YOUTUBE_CHANNEL_ID=UCFVYXzp-BW5CxFI5GEdCZww
NEXT_PUBLIC_SOCIAL_FEED_INTERVAL=6
