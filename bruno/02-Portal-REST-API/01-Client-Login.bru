meta {
  name: Portal: Client Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/local
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "identifier": "{{clientEmail}}",
    "password": "{{clientPassword}}"
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("jwt token received", function() {
    expect(res.getBody().jwt).to.be.a('string');
  });
}

script:post-response {
  if (res.getBody() && res.getBody().jwt) {
    bru.setVar("jwtToken", res.getBody().jwt);
  }
}
