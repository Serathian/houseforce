meta {
  name: Inbound: Client Reply to Update Thread
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/webhooks/inbound-email
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "From": "Jane Client <{{clientEmail}}>",
    "To": "update-{{updateId}}@replies.houseforce.com",
    "Subject": "Re: Project Update",
    "TextBody": "Thanks for the update! Are the windows arriving this week as well?\n\n> Previous message...",
    "StrippedTextReply": "Thanks for the update! Are the windows arriving this week as well?"
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });

  test("returns recorded message ID", function() {
    expect(res.getBody().data.messageId).to.be.a('number');
  });
}
