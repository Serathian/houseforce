script:pre-request {
  if (!bru.getVar("baseUrl")) {
    bru.setVar("baseUrl", "http://localhost:1337");
  }
  if (!bru.getVar("staffEmail")) {
    bru.setVar("staffEmail", "staff@houseforce.com");
  }
  if (!bru.getVar("clientEmail")) {
    bru.setVar("clientEmail", "client@example.com");
  }
  if (!bru.getVar("clientPassword")) {
    bru.setVar("clientPassword", "password123");
  }
  if (!bru.getVar("projectId")) {
    bru.setVar("projectId", 1);
  }
  if (!bru.getVar("updateId")) {
    bru.setVar("updateId", 1);
  }
}
