{
  "name": "houseforce-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "HouseForce residential construction, renovation, and keyholding platform",
  "workspaces": [
    "backend",
    "frontend",
    "portal",
    "shared-types"
  ],
  "scripts": {
    "dev": "docker compose up",
    "dev:down": "docker compose down",
    "dev:portal": "npm run dev -w portal",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run develop -w backend",

    "build": "npm run build --workspaces --if-present",
    "build:portal": "npm run build -w portal",
    "build:frontend": "npm run build -w frontend",
    "build:backend": "npm run build -w backend",

    "test": "npm test -w backend",
    "test:api": "npm run test:api -w backend",
    "test:workspaces": "npm test --workspaces --if-present",

    "lint": "npm run lint --workspaces --if-present",
    "lint:portal": "npm run lint -w portal",
    "lint:frontend": "npm run lint -w frontend",

    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:backend": "npm run typecheck -w backend",
    "typecheck:portal": "npm run typecheck -w portal",
    "typecheck:frontend": "npm run typecheck -w frontend"
  }
}
