{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": "A customer construction/renovation project"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "address": {
      "type": "string"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "planning",
        "in-progress",
        "completed",
        "on-hold"
      ],
      "default": "planning"
    },
    "clients": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user"
    },
    "updates": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::update.update",
      "mappedBy": "project"
    }
  }
}
